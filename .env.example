# --- PayPal sandbox (https://developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# Leave empty to run in MOCK mode (no network, simulated escrow).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: sandbox BUSINESS account e-mail of the supplier that should receive the funds.
# If empty, captured funds settle to the merchant account that owns the credentials above.
SUPPLIER_PAYEE_EMAIL=
# Optional: sandbox account e-mail that receives the evaluator agent's fee through PayPal Payouts.
# If empty, the fee is only credited on the network ledger.
EVALUATOR_PAYEE_EMAIL=

# --- AI provider (set ONE). Leave both empty for scripted agents (no AI). ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
PORT=3000
BASE_URL=http://localhost:3000
# Human-set guardrail: agents can never open an escrow above this amount.
MAX_ORDER_USD=1500
# Public demo guard: maximum new orders per hour.
RUNS_PER_HOUR=30
# Pause between protocol steps so the UI is watchable (ms).
STEP_DELAY_MS=700
# Simulated background traffic from other buyers: one job every N ms. 0 turns it off.
AMBIENT_MS=3500
